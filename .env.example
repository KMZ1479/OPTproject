# Example environment variables
# Copy this to .env.local with your specific endpoints

# Optimum Mobile API endpoints (detected from F12 > Network)
API_ENDPOINT=https://api.myoptimum.com/v1/auth/login
LOGIN_URL=https://www.myoptimum.com/login

# Request settings
REQUEST_TIMEOUT=30
REQUEST_RETRY_COUNT=3
REQUEST_DELAY_MIN=1
REQUEST_DELAY_MAX=3

# Headers for authentication skip if auto-detected
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
CONTENT_TYPE=application/json
ACCEPT=application/json